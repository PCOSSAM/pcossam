{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/ai-literacy-test",
      "destination": "/ai-literacy-test.html"
    },
    {
      "source": "/diagnosis",
      "destination": "/diagnosis.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        }
      ]
    }
  ]
}
